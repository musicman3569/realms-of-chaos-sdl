# Original game files - kept locally, not committed
game/
# A copy of game/ to play from (the port writes .HS / .SAV / .CFG next to the EXE)
play/
# Ghidra project files
ghidra/

# Generated by tools/unlzexe.py
unpacked/

__pycache__/
*.pyc

# Generated by tools/ghidra_dump.py (derived from the game code)
analysis/*.disasm.txt

# Generated by tools/tdinfo.py (symbols extracted from ROC.EXE)
analysis/*.tdinfo.txt

# Generated by tools/rocdat.py (the files inside game/ROC.DAT)
extracted/

# Generated by tools/extract_gfx.py
gfx/

# CMake build output
build/
*.png
!docs/*.png
!docs/screenshots/*.png

# Release packages
dist/
